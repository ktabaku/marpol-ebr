<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import jfxtras.scene.control.LocalDateTimeTextField?>

<AnchorPane fx:id="mainAnchorPane" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="al.sybina.ebr.logbook.views.history.EditLogController">
   <children>
      <ScrollPane focusTraversable="false" style="-fx-fit-to-width: true; -fx-fit-to-height: true;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox alignment="CENTER" style="-fx-background-color: #D6DCE5;">
               <children>
                  <GridPane alignment="CENTER_LEFT" hgap="10.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="50.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="50.0" prefWidth="70.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="50.0" prefHeight="50.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="50.0" prefHeight="50.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="50.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label styleClass="logbookOtherLabel" text="Log Type" />
                        <Label styleClass="logbookOtherLabel" text="Date" GridPane.columnIndex="1" />
                        <Label styleClass="logbookOtherLabel" text="Code Letter" GridPane.columnIndex="2" />
                        <Label styleClass="logbookOtherLabel" text="Code Number" GridPane.columnIndex="3" />
                        <Label styleClass="logbookOtherLabel" text="Content" GridPane.columnIndex="4" />
                        <Label styleClass="logbookOtherLabel" text="Name" GridPane.columnIndex="6" />
                        <Label styleClass="logbookOtherLabel" text="Signature" GridPane.columnIndex="8" />
                        <TextField fx:id="typeTextField" disable="true" editable="false" styleClass="logbook-text-field" GridPane.rowIndex="1" />
                        <TextField fx:id="codeLetterTextField" styleClass="logbook-text-field" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="codeNumberTextField" styleClass="logbook-text-field" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <TextField fx:id="signerNameTextField" disable="true" editable="false" styleClass="logbook-text-field" GridPane.columnIndex="6" GridPane.rowIndex="1" />
                        <ImageView fx:id="signatureImageView" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="8" GridPane.rowIndex="1" />
                        <LocalDateTimeTextField fx:id="dateTextField" disable="true" maxHeight="20.0" styleClass="logbook-LocalDateTimeTextFieldSkin" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label styleClass="logbookOtherLabel" text="Rank" GridPane.columnIndex="5" />
                        <Label styleClass="logbookOtherLabel" text="Surname" GridPane.columnIndex="7" />
                        <TextField fx:id="signerRankTextField" disable="true" styleClass="logbook-text-field" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                        <TextField fx:id="signerSurnameTextField" disable="true" editable="false" styleClass="logbook-text-field" GridPane.columnIndex="7" GridPane.rowIndex="1" />
                        <Label styleClass="logbookOtherLabel" text="Note" GridPane.rowIndex="3" />
                        <TextField fx:id="correctionNoteTextField" styleClass="logbook-text-field" GridPane.columnIndex="1" GridPane.columnSpan="4" GridPane.rowIndex="3" />
                        <TextArea fx:id="contentTextArea" styleClass="logbook-text-field" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </GridPane>
                  <ButtonBar prefHeight="40.0">
                     <buttons>
                        <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#cancel" style="-fx-background-color: #333F50;;" text="Cancel" textFill="WHITE" />
                        <Button mnemonicParsing="false" onAction="#openSignature" style="-fx-background-color: #ED7D31;" text="Signature" />
                        <Button fx:id="saveButton" disable="true" mnemonicParsing="false" onAction="#saveLog" style="-fx-background-color: #00B0F0;" text="Save" />
                     </buttons>
                     <padding>
                        <Insets right="20.0" />
                     </padding>
                  </ButtonBar>
               </children>
            </VBox>
         </content></ScrollPane>
   </children>
</AnchorPane>
