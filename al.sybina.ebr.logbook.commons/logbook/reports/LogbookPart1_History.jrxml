				<textElement textAlignment="Left">
					<font size="10"/>
				</textElement>
				<textFieldExpression><![CDATA["NOTE \r\n"+
"Oil Record Book Part I shall be provided to every oil tanker of 150 tons gross tonnage and above and every ship of 400 tons gross tonnage and above, other than oil tankers, to record relevant space operations. For oil tankers, Oil Record Book Part II shall also be provided to record relevant cargo/ballast operations."]]></textFieldExpression>
			</textField>
