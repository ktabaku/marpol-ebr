         <children>
            <ImageView fx:id="companyLogoImgView" fitHeight="120.0" pickOnBounds="true" preserveRatio="true">
               <FlowPane.margin>
                  <Insets left="120.0" top="100.0" />
               </FlowPane.margin>
            </ImageView>
         </children>
      </FlowPane>
      <FlowPane prefHeight="200.0" prefWidth="200.0">
         <children>
            <ImageView fx:id="titleLogbookImgView" fitHeight="220.0" pickOnBounds="true" preserveRatio="true">
