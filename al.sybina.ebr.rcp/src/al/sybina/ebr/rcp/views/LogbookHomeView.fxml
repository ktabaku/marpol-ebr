         </children>
      </FlowPane>
      <FlowPane alignment="CENTER_RIGHT" columnHalignment="CENTER" orientation="VERTICAL" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <ImageView fx:id="homeNewImgView" pickOnBounds="true" preserveRatio="true">
