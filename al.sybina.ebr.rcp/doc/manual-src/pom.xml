<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generates doc/EBR_USER_MANUAL.pdf (the manual Help > Help opens):
      mvn package
  Standalone build: not a module of the product build.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>al.sybina.ebr</groupId>
	<artifactId>al.sybina.ebr.manual</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>
	<name>MARPOL eRB user manual generator</name>

	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<!-- the PDF library JasperReports already uses in the product -->
		<dependency>
			<groupId>com.lowagie</groupId>
			<artifactId>itext</artifactId>
			<version>2.1.7</version>
			<exclusions>
				<!-- BouncyCastle is only needed for encryption and signing -->
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>build-manual</id>
						<phase>package</phase>
						<goals>
							<goal>java</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<mainClass>al.sybina.ebr.manual.BuildManual</mainClass>
					<arguments>
						<argument>${project.basedir}/images</argument>
						<argument>${project.basedir}/../EBR_USER_MANUAL.pdf</argument>
					</arguments>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
