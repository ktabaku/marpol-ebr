<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows download: the product with the bundled Java runtime in jre/ -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
	<id>windows-x64</id>
	<formats>
		<format>zip</format>
	</formats>
	<baseDirectory>MARPOL-eRB</baseDirectory>
	<fileSets>
		<fileSet>
			<directory>${project.build.directory}/products/MARPOL-ERB-SERVER/win32/win32/x86_64</directory>
			<outputDirectory>/</outputDirectory>
		</fileSet>
		<fileSet>
			<directory>${jre.dir}/windows/${jre.folder}</directory>
			<outputDirectory>jre</outputDirectory>
		</fileSet>
		<fileSet>
			<directory>${project.basedir}/..</directory>
			<outputDirectory>/</outputDirectory>
			<includes>
				<include>LICENSE</include>
			</includes>
		</fileSet>
	</fileSets>
</assembly>
