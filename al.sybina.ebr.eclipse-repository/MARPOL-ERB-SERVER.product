<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>

<product name="MARPOL-ERB-SERVER" uid="MARPOL-ERB-SERVER" id="al.sybina.ebr.rcp.product" application="org.eclipse.fx.ui.workbench.fx.main-thread-application" version="1.0.0" useFeatures="true" includeLaunchers="true">

   <aboutInfo>
      <image path="/al.sybina.ebr.rcp/icons/ebr256.png"/>
      <text>
         MARPOL-ERB-SERVER
      </text>
   </aboutInfo>

   <configIni use="default">
   </configIni>

   <launcherArgs>
      <programArgs>-clean
-clearPersistedState
      </programArgs>
      <programArgsMac>-vm ../Eclipse/jre/bin/java
      </programArgsMac>
      <vmArgs>-Dfile.encoding=UTF-8 -Dosgi.requiredJavaVersion=1.8 -Xms512m -Xmx1024m -Dprism.maxvram=512m -Dorg.osgi.framework.bundle.parent=ext -Dosgi.framework.extensions=org.eclipse.fx.osgi -Defxclipse.osgi.hook.debug=true
      </vmArgs>
   </launcherArgs>

   <windowImages i16="/al.sybina.ebr.rcp/icons/ebr16.png" i32="/al.sybina.ebr.rcp/icons/ebr32.png" i48="/al.sybina.ebr.rcp/icons/ebr48.png" i64="/al.sybina.ebr.rcp/icons/ebr64.png" i128="/al.sybina.ebr.rcp/icons/ebr128.png" i256="/al.sybina.ebr.rcp/icons/ebr256.png"/>

   <splash
      location="org.eclipse.e4.tools.resources"
      startupProgressRect="5,350,295,15"
      startupMessageRect="5,365,295,20"
      startupForegroundColor="0000FF" />
   <launcher name="MARPOL-ERB-SERVER">
      <win useIco="true">
         <ico path="/al.sybina.ebr.rcp/icons/eLogBooks.ico"/>
         <bmp/>
      </win>
   </launcher>

   <intro introId="al.sybina.ebr.rcp.intro1"/>

   <vm>
      <windows include="false">org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-1.8</windows>
   </vm>

   <plugins>
   </plugins>

   <features>
