   </features>

   <configurations>
      <plugin id="al.sybina.ebr.jasperreports" autoStart="true" startLevel="5" />
      <plugin id="al.sybina.ebr.logbook.commons" autoStart="true" startLevel="5" />
      <plugin id="al.sybina.ebr.logbook.domain" autoStart="true" startLevel="5" />
      <plugin id="al.sybina.ebr.logbook.ui" autoStart="true" startLevel="5" />
      <plugin id="al.sybina.ebr.login" autoStart="false" startLevel="5" />
